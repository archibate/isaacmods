#!/usr/bin/env bash
# Run Isaac on the agent's own desktop (the shared Xvfb :99 agent desktop),
# so a repro round needs nobody at the real screen. The game is started the way
# Steam starts it — the sniper runtime around Proton around the REPENTOGON
# launcher — with a minimal environment built here, never copied from a running
# process (the shell's exported secrets would come along).
#
#   ./isaacdesk start     launch, press the launcher's button, size the window
#   ./isaacdesk key F1    one held keypress to the game (a tap is too short for it)
#   ./isaacdesk shot      capture the game window, print the PNG path
#   ./isaacdesk stop      close the game window
#   ./isaacdesk cpu 100   cap the game at that % of one core (`off` lifts the cap)
#
# Once its window is up the game is capped at ISAACDESK_CPU (default 10) % of one
# core: software rendering otherwise takes six cores and the fans with them. The
# game then runs many times slower, which a devrepro list, counting frames, does
# not notice; `key` lifts the cap for the press itself, and `stop` for good.
#
# ISAACDESK_VANILLA=1 ./isaacdesk start runs the plain isaac-ng.exe instead, no
# REPENTOGON and no launcher: what a player without the extension sees.
#
# One Wine prefix serves both desktops, so the game must not be running on the
# real one: a leftover REPENTOGON launcher window there blocks this launch until
# it is closed. Rendering is software (llvmpipe).
set -euo pipefail

export DISPLAY="${ISAACDESK_DISPLAY:-:99}"
STEAM="$HOME/.local/share/Steam"
ISAAC="$STEAM/steamapps/common/The Binding of Isaac Rebirth"
PROTON="$STEAM/steamapps/common/${ISAACDESK_PROTON:-Proton 9.0 (Beta)}"
RUNTIME="$STEAM/steamapps/common/SteamLinuxRuntime_sniper"
TITLE="Binding of Isaac"

game_window() { xdotool search --onlyvisible --name "$TITLE" 2>/dev/null | head -n 1; }
launcher_window() { xdotool search --onlyvisible --name "REPENTOGON Launcher" 2>/dev/null | head -n 1; }

# the Windows-side processes carry Z:\ paths; the Linux wrappers around them
# mention the same exe names, so the anchor keeps them out
GAME_PROC='^Z:.*isaac-ng\.exe'
LAUNCHER_PROC='^Z:.*REPENTOGONLauncher\.exe'

EXE="$ISAAC/REPENTOGONLauncher/REPENTOGONLauncher.exe"
[[ -n "${ISAACDESK_VANILLA:-}" ]] && EXE="$ISAAC/isaac-ng.exe"

launch() {
	if pgrep -f "$GAME_PROC" >/dev/null; then
		echo "isaac-ng.exe is already running (on some desktop); stop it first" >&2
		exit 1
	fi
	if pgrep -f "$LAUNCHER_PROC" >/dev/null; then
		echo "a REPENTOGON launcher is still open, which holds the Wine prefix; close it first (./isaacdesk stop closes this desktop's)" >&2
		exit 1
	fi
	# the game reads mods/ and writes savedatapath.txt under its working directory
	cd "$ISAAC"
	env -i \
		HOME="$HOME" PATH="/usr/local/bin:/usr/bin:/bin" USER="$USER" LANG="${LANG:-C.UTF-8}" \
		XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
		DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}" \
		DISPLAY="$DISPLAY" \
		SteamEnv=1 SteamAppId=250900 SteamGameId=250900 SteamOverlayGameId=250900 \
		STEAM_COMPAT_APP_ID=250900 STEAM_COMPAT_PROTON=1 STEAM_COMPAT_FLAGS=search-cwd \
		STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM" \
		STEAM_COMPAT_DATA_PATH="$STEAM/steamapps/compatdata/250900" \
		STEAM_COMPAT_INSTALL_PATH="$ISAAC" \
		STEAM_COMPAT_LIBRARY_PATHS="$STEAM/steamapps" \
		STEAM_COMPAT_SHADER_PATH="$STEAM/steamapps/shadercache/250900" \
		STEAM_COMPAT_TOOL_PATHS="$PROTON:$RUNTIME" \
		STEAM_COMPAT_MOUNTS="$STEAM/steamapps/common/Steamworks Shared:$PROTON:$RUNTIME" \
		PROTON_CRASH_REPORT_DIR=/tmp/proton_crashreports \
		setsid -f "$RUNTIME/_v2-entry-point" --verb=waitforexitandrun -- \
		"$PROTON/proton" waitforexitandrun \
		"$EXE" >/tmp/isaacdesk.log 2>&1
}

start() {
	local w="" geo="" g=""
	w=$(launcher_window) || true
	[[ -n "$w" ]] || launch
	if [[ -n "${ISAACDESK_VANILLA:-}" ]]; then
		echo "waiting for the vanilla game window..." >&2
		# a short-lived first window precedes the real one, so the one found has
		# to still be there five seconds later
		local deadline=$((SECONDS + 240)) g2=""
		while ((SECONDS < deadline)); do
			g=$(game_window) || true
			if [[ -n "$g" ]]; then
				sleep 5
				g2=$(game_window) || true
				[[ "$g2" == "$g" ]] && break
			fi
			g=""
			sleep 2
		done
		[[ -n "$g" ]] || { echo "no game window after 240 s; see /tmp/isaacdesk.log" >&2; exit 1; }
		xdotool windowmove "$g" 0 0 windowsize "$g" 1440 810 windowactivate "$g"
		cpu "${ISAACDESK_CPU:-10}"
		echo "vanilla game up on $DISPLAY" >&2
		return
	fi
	echo "waiting for the REPENTOGON launcher..." >&2
	# The launcher shows a short-lived window of the same name first, then the
	# real one, which grows once laid out (479 tall; about 314 before). So every
	# pass looks the window up afresh, asks it for its geometry, and presses the
	# wide "Launch game" button along its bottom only once it has its full
	# height; the press is repeated until the game window shows
	local deadline=$((SECONDS + 240))
	while ((SECONDS < deadline)); do
		g=$(game_window) || true
		[[ -n "$g" ]] && break
		w=$(launcher_window) || true
		if [[ -n "$w" ]] && geo=$(xdotool getwindowgeometry --shell "$w" 2>/dev/null); then
			eval "$geo"
			if ((HEIGHT > 400)); then
				echo "pressing the launcher's button..." >&2
				xdotool mousemove $((X + WIDTH / 2)) $((Y + HEIGHT - 34)) sleep 0.3 click 1
				for _ in $(seq 1 15); do
					g=$(game_window) || true
					[[ -n "$g" ]] && break
					sleep 2
				done
				[[ -n "$g" ]] && break
				continue
			fi
		fi
		sleep 2
	done
	[[ -n "$g" ]] || { echo "no game window after 240 s; see /tmp/isaacdesk.log" >&2; exit 1; }
	sleep 5
	# options.ini's window size is taller than this desktop; the game letterboxes any size
	xdotool windowmove "$g" 0 0 windowsize "$g" 1440 810 windowactivate "$g"
	cpu "${ISAACDESK_CPU:-10}"
	echo "game up on $DISPLAY; title screen takes a while under software rendering" >&2
}

# The cap is a systemd scope of the game's own, made by moving isaac-ng.exe into
# it: the game's original scope also holds whatever terminal launched it, which a
# cap there would slow too. Only isaac-ng.exe burns CPU, so nothing else moves.
game_pid() { pgrep -f "$GAME_PROC" | head -n 1; }
game_cgroup() { echo "/sys/fs/cgroup$(cut -d: -f3 "/proc/$1/cgroup")"; }

cpu() {
	local pid unit quota=""
	# the user's own game, on their screen, is not this script's to cap
	[[ -n "$(game_window)" ]] || { echo "no game window on $DISPLAY" >&2; exit 1; }
	pid=$(game_pid) && [[ -n "$pid" ]] || { echo "isaac-ng.exe is not running" >&2; exit 1; }
	unit="isaacdesk-$pid.scope"
	[[ "$1" == off ]] || quota="${1%\%}%"
	if [[ "$(game_cgroup "$pid")" != */"$unit" ]]; then
		busctl --user call org.freedesktop.systemd1 /org/freedesktop/systemd1 \
			org.freedesktop.systemd1.Manager StartTransientUnit 'ssa(sv)a(sa(sv))' \
			"$unit" fail 2 PIDs au 1 "$pid" Description s "Isaac on $DISPLAY, CPU-capped" 0 >/dev/null
		for _ in $(seq 1 20); do
			[[ "$(game_cgroup "$pid")" == */"$unit" ]] && break
			sleep 0.1
		done
	fi
	systemctl --user set-property --runtime "$unit" CPUQuota="$quota"
}

# the cap as `cpu` takes it back, read from the cgroup: "max 100000" or "10000 100000"
cpu_now() {
	local f max period
	f="$(game_cgroup "$(game_pid)")/cpu.max"
	# no cpu.max: a cgroup without the cpu controller, that is, never capped
	[[ -r "$f" ]] || { echo off; return; }
	read -r max period <"$f"
	[[ "$max" == max ]] && echo off || echo $((max * 100 / period))
}

# A key only counts once the game holds the focus. Anything else on this desktop
# that takes it turns the press into a window-manager shortcut instead -- openbox
# opens a terminal on Super+Return, so a press sent blind lands as a new kitty
# window and the game never sees it. Clear the modifiers, take the focus, check we
# got it, and refuse the press rather than leak it.
key() {
	local g m focused
	g=$(game_window) && [[ -n "$g" ]] || { echo "no game window on $DISPLAY" >&2; exit 1; }
	for m in Super_L Super_R Alt_L Alt_R Control_L Control_R Shift_L Shift_R; do
		xdotool keyup "$m" || true
	done
	for _ in 1 2 3; do
		xdotool windowactivate --sync "$g"
		focused=$(xdotool getwindowfocus) || true
		((focused == g)) && break
		sleep 1
	done
	((focused == g)) || {
		echo "the game does not hold the focus ($focused holds it); $1 not sent" >&2
		exit 1
	}
	# a capped game draws its frames too far apart to see a 0.25 s hold
	local was
	was=$(cpu_now)
	cpu off
	xdotool keydown --clearmodifiers "$1"
	sleep 0.25
	xdotool keyup --clearmodifiers "$1"
	sleep 0.25
	cpu "$was"
}

# the window alone, not the root: its pixels are the ones `xdotool mousemove
# --window` addresses, and a fresh path each time keeps a failed capture from
# passing off an older frame
shot() {
	local g out
	g=$(game_window) && [[ -n "$g" ]] || { echo "no game window on $DISPLAY" >&2; exit 1; }
	out=$(mktemp /tmp/isaacdesk-shot-XXXXXX.png)
	import -window "$g" "$out"
	echo "$out"
}

# the launcher outlives the game and keeps the Wine prefix busy, so it goes too
stop() {
	local g
	if g=$(game_window) && [[ -n "$g" ]]; then
		# capped, the game would take minutes to shut down
		cpu off
		wmctrl -i -c "$g"
		for _ in $(seq 1 15); do
			pgrep -f "$GAME_PROC" >/dev/null || break
			sleep 2
		done
	fi
	pkill -f "$LAUNCHER_PROC" || true
}

case "${1:-}" in
start) start ;;
key) key "${2:?key name, e.g. F1}" ;;
shot) shot ;;
stop) stop ;;
cpu) cpu "${2:?percent of one core, or off}" ;;
*) sed -n '2,24p' "$0" >&2; exit 2 ;;
esac
